    "catalog_issues": [
      {
        "metric": "tool_recall",
        "issue": "The catalog marks score_type as binary, but the implementation can return fractional recall len(hits)/len(expected_names), for example 0.4.",
        "expected_fix": "score_type should be ratio_or_binary; the score range is [0, 1]."
      },
      {
        "metric": "task_succeeded",
        "issue": "The catalog lists <status>, but the implementation can emit any lowercased task_output.status string, or missing.",
        "expected_fix": "label should allow ok, missing, or a lowercased status string pattern."
      }
    ],
    "v2_applied_label_fixes": {
      "tool_hallucination": "labels updated to [clean, hallucinated, no_tool_calls, unmeasured] in V2 catalog.",
