    "kind": "LLM = judged by an LLM; CODE = computed deterministically without an LLM.",
    "score_type": "binary = 0/1; graded = fixed levels between 0 and 1; magnitude = raw magnitude with band labels, not a 0-1 quality score.",
    "positive_label": "The label corresponding to score=1.0 or the highest score.",
    "labels": "All labels that the metric may output; magnitude metrics use band labels."
  },
  "score_domain_legend": {
    "discrete_enum": "score must be one of the fixed numbers in allowed_values.",
    "continuous_range": "score may be any real number within the specified minimum/maximum bounds.",
    "discrete_integer_range": "score is an integer count returned as a float; validation should require a non-negative integer-like value."
  },
  "common_output_shape": {
    "type": "object",
    "required": [
      "score",
      "label",
      "explanation"
    ],
    "properties": {
      "score": {
        "type": "number"
      },
      "label": {
        "type": "string"
      },
      "explanation": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "invalid_for_success": {
