# A2E local environment — copy to `.env` and fill in real values.
# NEVER commit `.env` (gitignored). Used by A2E runners and a2e serve.
#
# Priority: CLI flags > `.env` / env vars > code defaults.
#
# | What to change                    | Where                                              |
# |-----------------------------------|----------------------------------------------------|
# | Default model                     | A2E_MODEL                                          |
# | One-off model                     | CLI `--model`                                      |
# | OpenAI-compatible endpoint / key  | OPENAI_API_BASE / OPENAI_API_KEY, or `--api-base` / `--api-key` |
# | Anthropic endpoint / key          | ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY             |
# | Where trajectories land           | A2E_WORKING_DIR when starting a2e serve (unset → ~/.a2e/a2e.db) |

# ── Default model for all agent frameworks × all datasets ──
# Any tool-capable model the endpoint serves (e.g. deepseek-chat, qwen-max).
A2E_MODEL=qwen3-coder-plus

# ── OpenAI-compatible endpoint (most agents) ──
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# ── Anthropic Messages API (claude-sdk only) ──
# ANTHROPIC_BASE_URL must NOT have a trailing /v1 (the SDK appends /v1/messages).
ANTHROPIC_API_KEY=sk-your-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
