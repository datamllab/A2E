# A2E local environment — NEVER commit this file (gitignored by .gitignore).
# Used by test/mingxuan/conftest.py and the A2E runners.

# ── Unified model for all agent frameworks × all datasets ──
# qwen3-coder-plus: code-specialized agentic model, strong & stable native
# tool calling — works for both sandbox (SWE-bench) and non-sandbox datasets.
# This is the single default for every agent (each reads A2E_MODEL).
# Swap freely to any tool-capable model the endpoint serves
# (e.g. deepseek-chat, qwen-max, qwen2.5-72b-instruct).
A2E_MODEL=qwen3-coder-plus

# ── langgraph / smolagents — OpenAI-compatible endpoint ──
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_BASE=http://35.220.164.252:3888/v1/

# ── claude-sdk — Anthropic Messages API ──
# This endpoint also speaks the Anthropic /v1/messages protocol, so the
# Claude Agent SDK / `claude` CLI can be pointed at it. ANTHROPIC_BASE_URL
# has NO trailing /v1 (the SDK appends /v1/messages itself).
ANTHROPIC_API_KEY=sk-your-key-here
ANTHROPIC_BASE_URL=http://35.220.164.252:3888
